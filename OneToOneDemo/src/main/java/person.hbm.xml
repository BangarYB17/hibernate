<?xml version="1.0" encoding="UTF-8"?>
<hibernate-mapping>
           <class name="test.Person" table="per_rel">
                  <id name="id" column="id">
                        <generator class="increment"></generator>
                  </id>
                  
                  <property name="name" column="name"></property>
                 
                 
                  <many-to-one name="passport" class="test.Passport" cascade="all"></many-to-one>
           </class>
</hibernate-mapping>